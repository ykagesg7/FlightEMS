{
  "version": 2,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/mfa-recovery-codes.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/weather.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/swim-notam-search.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/account/delete.ts": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/cron.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/telemetry-approve.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/api/account/mfa-recovery-codes/(generate|consume|status|clear)",
      "dest": "/api/mfa-recovery-codes?action=$1"
    },
    {
      "src": "/api/aviation-weather",
      "dest": "/api/weather?action=aviation"
    },
    {
      "src": "/api/rainviewer-maps",
      "dest": "/api/weather?action=rainviewer"
    },
    {
      "src": "/api/cron/(cohort-weekly|article-publish-sync|article-weekly-digest)",
      "dest": "/api/cron?job=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!assets/)(.*)",
      "dest": "/index.html"
    }
  ],
  "devCommand": "vite --port 5173 --strictPort",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/cohort-weekly",
      "schedule": "0 0 * * 0"
    },
    {
      "path": "/api/cron/article-publish-sync",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/cron/article-weekly-digest",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron/article-weekly-digest",
      "schedule": "0 22 * * 0"
    }
  ]
}
